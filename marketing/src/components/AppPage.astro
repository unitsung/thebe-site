---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeFor, siteConfig, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";

const text = isZh
  ? {
      title: "Thebe App · 原生 NAS 与 Homelab 工作台",
      description:
        "专为 Apple 平台打造的 Homelab 原生工作台。整合影视媒体、存储容量、下载中心、Docker 容器与网络服务，毫秒级响应，本地直连与受审批保护的智能协同。",
      eyebrow: "Thebe App · macOS / iOS / iPadOS 原生",
      heading: "把你已经运行的 homelab，装进一个原生工作台。",
      lead:
        "告别十几个凌乱的 Web 标签页。Thebe 将你的影视媒体、存储容量、下载任务、Docker 容器与网络服务整合进专为 Apple 平台精心打造的现代原生界面。毫秒级响应，本地原生直连，零云端中转。",
      primary: "即将登陆 App Store",
      secondary: "了解 Thebe Core",
      badges: ["SwiftUI 原生构建", "零云端中转", "本地 Keychain 存储", "审批门禁保护"],
      availability:
        "App Store 公开发布后，此页面会切换为官方下载入口。在此之前不使用占位链接。",
      visualAlt: "Thebe App 首页界面中的媒体播放流与全局看板",

      capabilitiesEyebrow: "核心能力",
      capabilitiesTitle: "打破服务壁垒，把离散的 Homelab 实体化。",
      capabilitiesLead: "不再需要记忆繁杂的端口号与内网 IP。所有组件皆以统一的原生对象呈现在你眼前。",
      capabilities: [
        {
          tag: "全景视界",
          title: "全局全景状态一览",
          body: "集中监控 Docker 容器、Proxmox/PVE 节点、存储池容量与实时网络吞吐。状态直接从局域网或内网获取，无任何第三方云端中转。",
        },
        {
          tag: "服务中枢",
          title: "基础设施与网络矩阵",
          body: "聚合管理 PVE 虚拟化、TrueNAS 存储、Arcane 容器、Beszel 主机监控、AdGuard 域名解析与 NPM 反向代理，各服务运行心跳实时掌握。",
        },
        {
          tag: "资源实体",
          title: "以资源为中心的实体化操作",
          body: "容器、服务、做种任务与存储卷不再是一串串孤立的链接。一键查看实时日志、控制起停或排查故障，操作确定、可重复。",
        },
        {
          tag: "受控协同",
          title: "受审批保护的智能助手",
          body: "基于本地与公有模型驱动的 Homelab 助手。结合上下文分析异常事件，工具调用过程完全透明，写操作必须经你确认后才可执行。",
        },
      ],

      galleryEyebrow: "界面预览",
      galleryTitle: "专注 Homelab 的原生交互体验。",
      galleryLead: "专为 iOS、iPadOS 与 macOS 打造，深色模式自然契合，信息密度与可读性完美平衡。",
      gallery: [
        {
          img: "/assets/app-home-zh.jpg",
          tag: "全景看板",
          title: "主机硬件负载与容器状态",
          desc: "CPU、内存、系统盘与多块硬盘温度实时呈现，容器故障显式预警。",
        },
        {
          img: "/assets/app-services-zh.jpg",
          tag: "服务矩阵",
          title: "基础设施与网络安全服务",
          desc: "一站式管理 PVE 虚拟化、TrueNAS 存储、Beszel 监控、AdGuard 与 UniFi 网络。",
        },
        {
          img: "/assets/app-library-zh.jpg",
          tag: "资料中枢",
          title: "多媒体聚合与私有资料库",
          desc: "无缝汇聚 Emby、Jellyfin、Navidrome 音乐与 Immich 智能相册，海报墙与播放直连无需频繁切应用。",
        },
      ],

      padEyebrow: "跨设备体验",
      padTitle: "从掌心到桌面，一致的 Apple 原生质感。",
      padLead: "适配 iPadOS 与 Apple Silicon Mac 多窗口分屏，大屏视野下硬件负载、存储池与 Ask Thebe 快捷指令尽收眼底。",
      padPoints: [
        "大屏多栏视野：一屏纵览全景看板、资料库、服务矩阵与快捷提问",
        "适配 Stage Manager 与 Split View，日常监控无缝融入桌面工作流",
        "深度支持 Apple Silicon Mac 键盘快捷键与多窗口调度",
      ],
      padImg: "/assets/app-pad-zh.jpg",
      padAlt: "Thebe App 在 iPad / Mac 上的大屏工作台界面",

      detailEyebrow: "从观察到行动",
      detailTitle: "发现问题，但绝不把控制权交给黑盒。",
      detailLead:
        "常规操作保持直接原生交互。只有当任务跨越多个服务、需要复杂推理或涉及环境变更时，Thebe 才引入 Agent 智能，并始终保留不可逾越的审批防线。",
      detailSteps: [
        {
          num: "01",
          name: "原生可观测",
          desc: "实时读取已连接服务的指标与日志，自动感知容器退出、磁盘水位报警等异常事件。",
        },
        {
          num: "02",
          name: "结构化诊断方案",
          desc: "遇到问题时，Agent 结合日志与上下文生成清晰的修复步骤，而不是漫无目的的自由发挥。",
        },
        {
          num: "03",
          name: "显式审批门禁",
          desc: "写操作、容器重启、配置变更以结构化动作卡片形式呈现，必须经由你明确点击批准才允许执行。",
        },
        {
          num: "04",
          name: "全量审计归档",
          desc: "执行过程与结果写入结构化审计记录，每一步动作皆有因可查、有据可循。",
        },
      ],
      repairAlt: "Thebe App 中结构化的容器修复动作卡片",
      repairCaption: "真实修复请求卡片：清晰列出操作对象与原因，等待用户手动确认",
      repairTitle: "发现服务异常：nginx 容器意外退出",
      repairMeta: "受监控节点: omv (192.168.1.10) · 影响范围: 外部 HTTP 反向代理",
      approvalTitle: "服务异常告警：homeassistant 意外退出",
      approvalMeta: "受监控节点: omv (192.168.1.110) · 端口: 8123",
      approvalDiagnosis: "智能助手已读取容器日志：检测到 8123 端口冲突导致进程中断。建议重启容器并应用端口隔离配置。",
      approvalCommand: "docker restart homeassistant && docker inspect --format='{{.State.Health.Status}}' homeassistant",
      approvalGateNotice: "高风险写操作 · 需用户明确点击批准方可执行",
      approvalRejectBtn: "驳回操作",
      approvalConfirmBtn: "批准并执行",
      approvalAuditFoot: "✓ 审批结果将与操作者签名一同存入不可变审计日志 (/activity)",

      modesEyebrow: "架构与连接",
      modesTitle: "按你的需求组合，没有任何锁定。",
      modes: [
        {
          kicker: "轻量独立",
          title: "App 独立运行模式",
          desc: "无需部署额外的中转服务端，App 直接利用局域网或内网隧道与 NAS、Docker、媒体服务直接通信。",
          features: [
            "客户端直连服务 API 与 SSH",
            "账号凭据加密存储于本机 Keychain",
            "零服务配置负担，开箱即用",
            "适合轻量化个人日常使用",
          ],
        },
        {
          kicker: "深度联动",
          title: "连接 Thebe Core 模式",
          desc: "在你的服务器或 NAS 上部署自托管的 Thebe Core 容器，将 App 升级为全能的自动化中枢。",
          features: [
            "解锁后台持续运行的 Goal 与定时任务",
            "提供标准 MCP 服务器，接入外部 AI 客户端",
            "服务端本地安全沙箱隔离保护",
            "只追加、防篡改的团队审计日志流",
          ],
        },
      ],

      privacyEyebrow: "隐私承诺",
      privacyTitle: "没有开发者账号，也没有中心数据服务器。",
      privacyBody:
        "Thebe 绝不在云端收集你的服务器地址、存储目录或账号凭据。网络请求严格限制在你的内网与所选的模型服务商之间。你的数据与硬件永远只属于你。",
      privacyAction: "阅读隐私政策",
      coreAction: "深入了解 Thebe Core",
    }
  : {
      title: "Thebe App · A Native NAS & Homelab Workspace",
      description:
        "A native homelab workspace crafted for Apple platforms. Unify media libraries, storage capacity, downloads, Docker containers, and networking services with instant response and approval-gated AI.",
      eyebrow: "Thebe App · Native macOS / iOS / iPadOS",
      heading: "The homelab you already run, in one native workspace.",
      lead:
        "Say goodbye to dozens of cluttered browser tabs. Thebe organizes your media libraries, storage capacity, download queues, Docker containers, and networking services into a refined native interface crafted for Apple devices. Millisecond response, direct local connectivity, and zero cloud relay.",
      primary: "Coming soon to the App Store",
      secondary: "Meet Thebe Core",
      badges: ["Native SwiftUI", "Zero Cloud Relay", "Local Keychain Storage", "Approval-Gated Safety"],
      availability:
        "This page will switch to the official download entry when the App Store listing becomes public. No placeholder store link is used.",
      visualAlt: "Media playback and system horizon in Thebe App",

      capabilitiesEyebrow: "Core Capabilities",
      capabilitiesTitle: "Break down silos. Turn your homelab into tangible resources.",
      capabilitiesLead: "No more memorizing port numbers and IP addresses. Every component appears as a consistent native object.",
      capabilities: [
        {
          tag: "Unified Horizon",
          title: "Whole-System Visibility",
          body: "Monitor Docker containers, Proxmox/PVE nodes, storage pool capacity, and network throughput together. Data comes straight from your local network without touching any third-party server.",
        },
        {
          tag: "Service Hub",
          title: "Infrastructure & Network Matrix",
          body: "Centrally manage PVE virtualization, TrueNAS storage, Arcane containers, Beszel metrics, AdGuard DNS, and NPM proxies with real-time health checks.",
        },
        {
          tag: "Entity-First",
          title: "Resource-Centric Operations",
          body: "Containers, services, torrents, and storage volumes are concrete objects instead of disconnected web links. View live logs, restart, stop, or troubleshoot directly.",
        },
        {
          tag: "Safe AI",
          title: "Approval-Gated Intelligence",
          body: "Context-aware AI assistant powered by local or cloud models. Traceable reasoning chains, token velocity stats, and mandatory approvals for write actions.",
        },
      ],

      galleryEyebrow: "Interface Preview",
      galleryTitle: "Native interaction tailored for homelab operations.",
      galleryLead: "Crafted specifically for iOS, iPadOS, and macOS with authentic dark-mode depth, high information density, and effortless readability.",
      gallery: [
        {
          img: "/assets/app-home-en.jpg",
          tag: "Horizon",
          title: "Hardware Metrics & Container Health",
          desc: "Live CPU, memory, system drive, and multi-disk temperatures with explicit container failure alerts.",
        },
        {
          img: "/assets/app-services-en.jpg",
          tag: "Services",
          title: "Infrastructure & Security Hub",
          desc: "Unified control for PVE, TrueNAS, Beszel, AdGuard DNS, and UniFi network gateways.",
        },
        {
          img: "/assets/app-library-en.jpg",
          tag: "Library",
          title: "Unified Media & Private Assets",
          desc: "Centralized hub for Emby, Jellyfin, Navidrome music, and Immich photos without switching between disjointed apps.",
        },
      ],

      padEyebrow: "Cross-Platform",
      padTitle: "From pocket to desktop, seamless Apple native craft.",
      padLead: "Optimized for iPadOS and Apple Silicon Mac multi-window multitasking, bringing all your hardware, containers, and Ask Thebe shortcuts into one broad canvas.",
      padPoints: [
        "Expansive multi-column canvas: overview, library, services, and shortcuts side-by-side",
        "Seamless support for Stage Manager and Split View alongside your terminal",
        "Keyboard shortcut optimizations tailored for Apple Silicon Mac multitasking",
      ],
      padImg: "/assets/app-pad-en.jpg",
      padAlt: "Thebe App expansive workspace on iPad and Mac",

      detailEyebrow: "From Observation to Action",
      detailTitle: "See the problem, without handing control to a black box.",
      detailLead:
        "Routine operations stay direct and deterministic. Thebe introduces agent intelligence only when a task crosses services, needs diagnosis, or changes the system—while preserving strict approval boundaries.",
      detailSteps: [
        {
          num: "01",
          name: "Native Observability",
          desc: "Continuously reads telemetry from connected services, detecting container exits and disk warnings automatically.",
        },
        {
          num: "02",
          name: "Structured Remediation",
          desc: "When issues arise, the agent generates concrete repair proposals based on real logs rather than open-ended guessing.",
        },
        {
          num: "03",
          name: "Explicit Approval Gate",
          desc: "Writes, container restarts, and config edits appear as structured action cards requiring your direct confirmation.",
        },
        {
          num: "04",
          name: "Audited Execution",
          desc: "Every step and verification outcome is preserved in an immutable local audit log for complete accountability.",
        },
      ],
      repairAlt: "Structured container repair card in Thebe App",
      repairCaption: "Real remediation card: outlines the exact target and reason, awaiting user confirmation",
      repairTitle: "Service Anomaly Detected: nginx exited unexpectedly",
      repairMeta: "Monitored host: omv (192.168.1.10) · Impact: External HTTP reverse proxy",
      approvalTitle: "Service Anomaly: homeassistant exited unexpectedly",
      approvalMeta: "Monitored Host: omv (192.168.1.110) · Port: 8123",
      approvalDiagnosis: "The agent analyzed container logs: port binding conflict caused unexpected termination. Recommended fix is restarting the container and verifying health status.",
      approvalCommand: "docker restart homeassistant && docker inspect --format='{{.State.Health.Status}}' homeassistant",
      approvalGateNotice: "High-risk write operation · Requires explicit manual approval",
      approvalRejectBtn: "Reject Action",
      approvalConfirmBtn: "Approve & Execute",
      approvalAuditFoot: "✓ Decisions and authorization signatures append to immutable local audit log (/activity)",

      modesEyebrow: "Architecture & Modes",
      modesTitle: "Choose how you run, with zero lock-in.",
      modes: [
        {
          kicker: "Standalone",
          title: "App Standalone Mode",
          desc: "No server deployment required. The App communicates directly with your NAS, Docker, and media services over LAN or secure tunnel.",
          features: [
            "Direct connection via service APIs and SSH",
            "Credentials stored securely in native Keychain",
            "Zero server overhead, instant setup",
            "Ideal for personal daily monitoring",
          ],
        },
        {
          kicker: "Core-Powered",
          title: "Connected to Thebe Core",
          desc: "Deploy the self-hosted Thebe Core container on your homelab to unlock persistent background execution and automation.",
          features: [
            "Persistent background Goals and scheduled routines",
            "Standards-compliant MCP server for external AI tools",
            "Host-level sandbox isolation and security barriers",
            "Append-only, tamper-resistant team audit trail",
          ],
        },
      ],

      privacyEyebrow: "Privacy by Design",
      privacyTitle: "No developer accounts. No telemetry servers.",
      privacyBody:
        "Thebe never collects your server hostnames, directory paths, or account credentials in the cloud. Network traffic is strictly confined to your local network and your chosen model provider. Your data and hardware remain entirely yours.",
      privacyAction: "Read Privacy Policy",
      coreAction: "Explore Thebe Core",
    };
---

<BaseLayout locale={locale} route="/app" title={text.title} description={text.description}>
  <article class="product-page app-page">
    <!-- HERO -->
    <section class="product-hero app-hero">
      <div class="product-hero-copy">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="hero-lead">{text.lead}</p>
        <div class="hero-badges" aria-label="App Highlights">
          {text.badges.map((b) => <span class="hero-badge">{b}</span>)}
        </div>
        <div class="hero-actions">
          {
            siteConfig.appStoreUrl ? (
              <a class="button button-primary" href={siteConfig.appStoreUrl}>App Store ↗</a>
            ) : (
              <span class="button button-primary button-disabled" aria-disabled="true">{text.primary}</span>
            )
          }
          <a class="button button-secondary" href={routeFor("/core", locale)}>{text.secondary}</a>
        </div>
        <p class="availability-note">{text.availability}</p>
      </div>
      <figure class="app-hero-device" aria-label={text.visualAlt}>
        <div class="device-glow" aria-hidden="true"></div>
        <div class="phone-frame">
          <img
            src={isZh ? "/assets/app-home-zh.jpg" : "/assets/app-home-en.jpg"}
            width="720"
            height="1565"
            alt={text.visualAlt}
          />
        </div>
      </figure>
    </section>

    <!-- CAPABILITIES 4-GRID -->
    <section class="section capability-section" aria-labelledby="capability-title">
      <div class="section-heading">
        <p class="eyebrow">{text.capabilitiesEyebrow}</p>
        <h2 id="capability-title">{text.capabilitiesTitle}</h2>
        <p>{text.capabilitiesLead}</p>
      </div>
      <div class="app-capability-grid">
        {
          text.capabilities.map((item, index) => (
            <article class="app-capability-card">
              <div class="card-header">
                <span class="card-num">{String(index + 1).padStart(2, "0")}</span>
                <span class="card-tag">{item.tag}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- SHOWCASE GALLERY -->
    <section class="section showcase-section" aria-labelledby="showcase-title">
      <div class="section-heading">
        <p class="eyebrow">{text.galleryEyebrow}</p>
        <h2 id="showcase-title">{text.galleryTitle}</h2>
        <p>{text.galleryLead}</p>
      </div>
      <div class="showcase-grid">
        {
          text.gallery.map((item) => (
            <div class="showcase-card">
              <div class="showcase-screen">
                <div class="showcase-screen-mockup">
                  <img src={item.img} width="720" height="1565" alt={item.title} />
                </div>
              </div>
              <div class="showcase-meta">
                <span class="showcase-tag">{item.tag}</span>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- IPAD & MAC DESKTOP CANVAS -->
    <section class="section pad-section" aria-labelledby="pad-title">
      <div class="pad-section-split">
        <div class="pad-copy">
          <p class="eyebrow">{text.padEyebrow}</p>
          <h2 id="pad-title">{text.padTitle}</h2>
          <p>{text.padLead}</p>
          <ul class="pad-points-list">
            {text.padPoints.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
        <div class="pad-frame-container">
          <div class="pad-frame">
            <img
              src={text.padImg}
              width="1200"
              height="1600"
              alt={text.padAlt}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- OBSERVATION TO ACTION & APPROVAL -->
    <section class="section detail-section app-action-section" aria-labelledby="detail-title">
      <div class="detail-copy">
        <p class="eyebrow">{text.detailEyebrow}</p>
        <h2 id="detail-title">{text.detailTitle}</h2>
        <p class="detail-lead">{text.detailLead}</p>
        <div class="action-steps-grid">
          {
            text.detailSteps.map((step) => (
              <div class="action-step-item">
                <span class="step-num">{step.num}</span>
                <div>
                  <h4>{step.name}</h4>
                  <p>{step.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="app-repair-container">
        <div class="approval-window-card">
          <div class="approval-window-top">
            <div class="approval-traffic-lights" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <span class="approval-window-title">Thebe Diagnostic &amp; Action</span>
          </div>
          <div class="approval-content">
            <div class="approval-alert-badge">
              <span aria-hidden="true">⚠️</span>
              <span>{text.approvalTitle}</span>
            </div>
            <div>
              <p class="approval-issue-desc">{text.approvalDiagnosis}</p>
            </div>
            <div class="approval-cmd-box">
              <span class="approval-cmd-label">{isZh ? "拟执行命令" : "Proposed Command"}</span>
              <code>{text.approvalCommand}</code>
            </div>
            <div class="approval-gate-notice">
              <span aria-hidden="true">🛡️</span>
              <span>{text.approvalGateNotice}</span>
            </div>
            <div class="approval-actions-bar">
              <button type="button" class="approval-btn-reject">{text.approvalRejectBtn}</button>
              <button type="button" class="approval-btn-confirm">{text.approvalConfirmBtn}</button>
            </div>
            <p class="approval-audit-line">{text.approvalAuditFoot}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STANDALONE VS CORE -->
    <section class="section modes-section" aria-labelledby="modes-title">
      <div class="section-heading">
        <p class="eyebrow">{text.modesEyebrow}</p>
        <h2 id="modes-title">{text.modesTitle}</h2>
      </div>
      <div class="modes-grid">
        {
          text.modes.map((mode) => (
            <article class="mode-card">
              <span class="mode-kicker">{mode.kicker}</span>
              <h3>{mode.title}</h3>
              <p class="mode-desc">{mode.desc}</p>
              <ul class="mode-feature-list">
                {mode.features.map((feat) => <li>{feat}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PRIVACY & ACTIONS -->
    <section class="section privacy-band" aria-labelledby="privacy-band-title">
      <div>
        <p class="eyebrow">{text.privacyEyebrow}</p>
        <h2 id="privacy-band-title">{text.privacyTitle}</h2>
        <p>{text.privacyBody}</p>
      </div>
      <div class="privacy-actions">
        <a class="button button-secondary" href={routeFor("/privacy", locale)}>{text.privacyAction}</a>
        <a class="text-link" href={routeFor("/core", locale)}>{text.coreAction} →</a>
      </div>
    </section>
  </article>
</BaseLayout>

