---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeFor, siteConfig, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text =
  locale === "zh"
    ? {
        title: "Thebe App · 原生 NAS 与 homelab 工作台",
        description:
          "在一个原生工作台中查看媒体库、下载、容器、虚拟机、文件与服务状态，并用受审批保护的 AI 处理复杂任务。",
        eyebrow: "Thebe App",
        heading: "把你已经运行的 homelab，装进一个原生工作台。",
        lead:
          "Thebe 不是另一个服务启动器。它把你的媒体、下载、容器、文件和活动翻译成同一套资源，让常用操作更快，让复杂问题有上下文。",
        primary: "即将登陆 App Store",
        secondary: "了解 Thebe Core",
        visualAlt: "Thebe App 首页中的容器、虚拟机、下载和服务状态",
        capabilitiesEyebrow: "日常界面",
        capabilitiesTitle: "常用操作留在手边。",
        capabilities: [
          {
            title: "先看整体状态",
            body: "服务、资源、容量与正在运行的内容集中呈现。状态来自你自己的环境，不经过开发者的中转服务器。",
          },
          {
            title: "按资源工作",
            body: "电影、文件、下载、容器与虚拟机使用稳定的对象语言。你处理的是工作，而不是一串网页地址。",
          },
          {
            title: "判断可以追溯",
            body: "Activity 记录正在发生什么、为什么发生，以及变更是否完成。需要执行的操作不会藏在自由文本后面。",
          },
        ],
        detailEyebrow: "从观察到行动",
        detailTitle: "看到问题，再把上下文交给 Agent。",
        detailBody:
          "常规操作仍然直接完成。只有任务跨越多个服务、需要诊断或涉及变更时，Thebe 才引入 Agent 推理，并保留审批与验证边界。",
        detailPoints: [
          "媒体、文件、容器、下载和服务在同一工作区中被识别。",
          "写操作以具体动作请求确认，而不是用一句模型回答代替授权。",
          "App 可以独立使用；连接你自己的 Core 后，复杂工作会进入 Activity。",
        ],
        screenshotAlt: "Thebe App 中需要修复的容器状态",
        screenshotCaption: "通用演示状态；不包含主机地址、账号或凭据",
        privacyEyebrow: "隐私不是附加项",
        privacyTitle: "没有开发者账号，也没有开发者数据服务器。",
        privacyBody:
            "App 设置、账号和服务地址保存在设备上。模型请求发送给你选择的服务商。你可以导出、备份或删除本机数据。",
        privacyAction: "阅读隐私政策",
        coreAction: "查看 Thebe Core",
        availability:
          "App Store 公开发布后，此页面会切换为官方下载入口。在此之前不使用占位链接。",
      }
    : {
        title: "Thebe App · A native NAS and homelab workspace",
        description:
          "See media libraries, downloads, containers, virtual machines, files, and service state in one native workspace, with approval-gated AI for difficult work.",
        eyebrow: "Thebe App",
        heading: "The homelab you already run, in one native workspace.",
        lead:
          "Thebe is not another service launcher. It turns your media, downloads, containers, files, and activity into one consistent set of resources, making routine work faster and complex work better informed.",
        primary: "Coming soon to the App Store",
        secondary: "Meet Thebe Core",
        visualAlt: "Container, virtual-machine, download, and service state in Thebe Home",
        capabilitiesEyebrow: "Daily workspace",
        capabilitiesTitle: "The routine work stays within reach.",
        capabilities: [
          {
            title: "Start with the whole system",
            body: "Services, resources, capacity, and active work appear together. State comes from your environment, without passing through a developer relay.",
          },
          {
            title: "Work by resource",
            body: "Movies, files, downloads, containers, and virtual machines use stable object language. You handle the work instead of a list of web addresses.",
          },
          {
            title: "Keep judgment traceable",
            body: "Activity records what is happening, why, and whether a change completed. Execution does not hide behind free-form model text.",
          },
        ],
        detailEyebrow: "From observation to action",
        detailTitle: "See the problem, then give the agent context.",
        detailBody:
          "Routine operations stay direct. Thebe introduces agent reasoning only when a task crosses services, needs diagnosis, or changes the environment, while preserving approval and verification boundaries.",
        detailPoints: [
          "Media, files, containers, downloads, and services are recognized in one workspace.",
          "A write asks for confirmation on a concrete action instead of treating model text as authorization.",
          "The App works alone. Connect your own Core to move complex work into Activity.",
        ],
        screenshotAlt: "A container repair item in the Thebe App",
        screenshotCaption: "Generic demonstration state with no host address, account, or credential",
        privacyEyebrow: "Privacy is not an add-on",
        privacyTitle: "No developer account. No developer data server.",
        privacyBody:
          "App settings, accounts, and service addresses stay on the device. Model requests go to the provider you choose. You can export, back up, or delete local data.",
        privacyAction: "Read the privacy policy",
        coreAction: "Explore Thebe Core",
        availability:
          "This page will switch to the official download entry when the App Store listing becomes public. No placeholder store link is used.",
      };
---

<BaseLayout locale={locale} route="/app" title={text.title} description={text.description}>
  <article class="product-page app-page">
    <section class="product-hero">
      <div class="product-hero-copy">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="hero-lead">{text.lead}</p>
        <div class="hero-actions">
          {
            siteConfig.appStoreUrl ? (
              <a class="button button-primary" href={siteConfig.appStoreUrl}>App Store ↗</a>
            ) : (
              <span class="button button-primary button-disabled" aria-disabled="true">{text.primary}</span>
            )
          }
          <a class="button button-secondary" href={routeFor("/core", locale)}>{text.secondary}</a>
        </div>
        <p class="availability-note">{text.availability}</p>
      </div>
      <figure class="product-phone">
        <img src="/assets/home-status.png" width="720" height="738" alt={text.visualAlt} />
      </figure>
    </section>

    <section class="section capability-section" aria-labelledby="capability-title">
      <div class="section-heading">
        <p class="eyebrow">{text.capabilitiesEyebrow}</p>
        <h2 id="capability-title">{text.capabilitiesTitle}</h2>
      </div>
      <div class="capability-grid">
        {
          text.capabilities.map((capability, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section detail-section" aria-labelledby="detail-title">
      <div class="detail-copy">
        <p class="eyebrow">{text.detailEyebrow}</p>
        <h2 id="detail-title">{text.detailTitle}</h2>
        <p>{text.detailBody}</p>
        <ul>
          {text.detailPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <figure class="repair-figure">
        <img
          src="/assets/app-repair.png"
          width="700"
          height="430"
          loading="lazy"
          alt={text.screenshotAlt}
        />
        <figcaption>{text.screenshotCaption}</figcaption>
      </figure>
    </section>

    <section class="section privacy-band" aria-labelledby="privacy-band-title">
      <div>
        <p class="eyebrow">{text.privacyEyebrow}</p>
        <h2 id="privacy-band-title">{text.privacyTitle}</h2>
        <p>{text.privacyBody}</p>
      </div>
      <div class="privacy-actions">
        <a class="button button-secondary" href={routeFor("/privacy", locale)}>{text.privacyAction}</a>
        <a class="text-link" href={routeFor("/core", locale)}>{text.coreAction} →</a>
      </div>
    </section>
  </article>
</BaseLayout>

